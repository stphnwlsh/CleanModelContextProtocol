{
  "$schema": "https://json.schemastore.org/ide.host",
  "icon": "icon.png",
  "description": {
    "text": "A Model Context Protocol server on the MCP C# SDK and .NET 10, built with Clean Architecture minus the ceremony. Mug not included."
  },
  "tags": [
    {
      "type": "platform",
      "add": [
        "Linux",
        "macOS",
        "Windows"
      ]
    },
    {
      "type": "projectType",
      "add": [
        "Service",
        "AI"
      ]
    }
  ],
  "symbolInfo": [
    {
      "id": "authorName",
      "name": {
        "text": "Author name"
      },
      "description": {
        "text": "Your name, for the Authors and Copyright lines."
      },
      "isVisible": true,
      "persistenceScope": "shared",
      "persistenceScopeName": "LeanMeanCleanApps"
    },
    {
      "id": "auth",
      "name": {
        "text": "Authentication"
      },
      "description": {
        "text": "How the server checks who is calling. None leaves it open, and you can switch it on later in appsettings.json."
      },
      "isVisible": true,
      "choices": [
        {
          "id": "none",
          "name": {
            "text": "None"
          },
          "description": {
            "text": "No sign in. Everything is open."
          }
        },
        {
          "id": "oauth",
          "name": {
            "text": "OAuth"
          },
          "description": {
            "text": "Access tokens from your authorization server."
          }
        }
      ]
    },
    {
      "id": "authority",
      "name": {
        "text": "Token authority"
      },
      "description": {
        "text": "The OAuth authorization server that issues access tokens."
      },
      "isVisible": true
    },
    {
      "id": "audience",
      "name": {
        "text": "Token audience (optional)"
      },
      "description": {
        "text": "Who the tokens are for, usually the server's own URL."
      },
      "isVisible": true
    }
  ]
}
